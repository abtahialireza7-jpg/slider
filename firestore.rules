rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidScore(d) {
      return d.keys().hasOnly(['size', 'name', 'timeMs', 'moves', 'ts', 'playerId'])
        && d.size is string && d.size.size() <= 10
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.timeMs is number && d.timeMs > 0 && d.timeMs < 86400000
        && d.moves is number && d.moves > 0 && d.moves < 100000
        && d.playerId is string && d.playerId.size() > 0 && d.playerId.size() <= 100
        && d.ts is number;
    }

    // Leaderboard entries: anyone can read (that's the point of a public
    // leaderboard). Writes are limited to one document per player per size
    // (doc id must be "<playerId>_<size>"), and an existing entry can only
    // ever be overwritten by a strictly better (lower) time for that same
    // player and size, so nobody's best score can be erased or inflated.
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if isValidScore(request.resource.data)
                    && scoreId == request.resource.data.playerId + '_' + request.resource.data.size;

      allow update: if isValidScore(request.resource.data)
                    && request.resource.data.playerId == resource.data.playerId
                    && request.resource.data.size == resource.data.size
                    && request.resource.data.timeMs < resource.data.timeMs;

      allow delete: if false;
    }
  }
}
